<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Uploader</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <% if (user) { %> 
    <h1>You're logged in, <%= user.username.split("@")[0] %></h1>
    <% if (folders.length > 0) { %>
    <section>
      <h2>Your Folders and Files</h2>
      <section>
        <% folders.forEach(folder => { %>
          <article>
            <h3><%= folder.name %></h3>
            <button type="button" onclick="document.getElementById('edit-form-<%= folder.id %>').style.display='block'">Rename</button>
            <form action="/folders/<%= folder.id %>/delete" method="POST" style="display: inline;">
              <button type="submit" onclick="return confirm('Delete folder and all files?')">Delete</button>
            </form>
            <div id="edit-form-<%= folder.id %>" style="display: none; margin-top: 5px;">
              <form action="/folders/<%= folder.id %>/update" method="post">
                <input type="text" name="newName" value="<%= folder.name %>" required>
                <button type="submit">Save</button>
                <button type="button" onclick="this.parentElement.parentElement.style.display='none'">Cancel</button>
              </form>
            </div>
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Size</th>
                  <th>Created</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% folder.files.forEach(file => { %>
                  <tr>
                    <td>
                      <a href="/<%= folder.id %>/<%= file.name %>"><%= file.name %></a> 
                    </td>
                    <td><%= formatBytes(file.size) %></td>
                    <td><%= formatDate(file.createdAt) %></td>
                    <td>    
                      <form action="/files/<%= file.id %>/delete" method="POST">
                        <button type="submit" onclick="return confirm('Delete file?')">Delete</button>
                      </form>
                      <a href="/files/<%= file.id %>/download">Download</a>
                    </td>
                  </tr>
                <% }); %>  
              </tbody>
            </table>
          </li>
        <% }); %>
      </ul>
    </section>
    <% } %>
    <hr>
    <section>
      <h2>Create a Folder</h2>
      <form action="/folders" method="post">
        <input type="text" name="folderName" placeholder="Folder Name" required>
        <button type="submit">Create Folder</button>
      </form>
    </section>
    <hr>
    <section>
      <h2>Upload a File</h2>
      <form action="/upload" method="post", enctype="multipart/form-data">
        <% if (folders.length > 0) { %>
        <label for="folderId">Choose Folder:</label>
        <select name="folderId" id="folderId" required>
          <option value="">-- Select a Folder --</option>
          <% folders.forEach(folder => { %>
            <option value="<%= folder.id %>"><%= folder.name %></option>
          <% }); %>
        </select>
        <% } %>
        <input type="file" name="uploadedFile" required>
        <button type="submit">Save</button>
      </form>
    </section>
    <div class="logout"><a href="/log-out">Log out</a></div>
    <% } else { %>
    <main class="login">
      <h2>Log in</h2>
      <form action="/log-in" method="POST">
        <%- include('partials/userAuthenticationError') %>
        <div>
          <label for="username">Email</label>
          <input id="username" name="username" type="email" required />
        </div>
        <div>
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required />
        </div>
        <div><button type="submit">Log In</button></div>
      </form>
      <small>Don't have an account? <a href="/sign-up">Sign up</a></small>
    </main>
    <%}%>
    <footer>
      <a href="https://github.com/nzubeifechukwu/file-uploader" target="_blank"><small>&copy; Nzube Ifechukwu</small></a>
    </footer>
  </body>
</html>