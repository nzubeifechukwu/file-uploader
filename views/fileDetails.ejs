<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= file.name %> | File Uploader</title>
  </head>
  <body>
    <nav><a href="/">Go Home</a></nav>
    <main>
      <h1>Hello, <%= user.username.split("@")[0] %></h1>
      <p>
        Your file <strong><%= file.name %></strong> is of size
        <strong><%= file.size %> bytes</strong>.
      </p>
      <a href="/files/<%= file.id %>/download">Download File</a>
      <form
        action="/files/<%= file.id %>/delete"
        method="POST"
        style="display: inline"
      >
        <button type="submit" onclick="return confirm('Delete file?');">
          Delete File
        </button>
      </form>
    </main>
    <footer>
      <a href="https://github.com/nzubeifechukwu/file-uploader" target="_blank"
        ><small>&copy; Nzube Ifechukwu</small></a
      >
    </footer>
  </body>
</html>
