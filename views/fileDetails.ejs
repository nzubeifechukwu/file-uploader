<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= file.name %> | File Uploader</title>
  </head>
  <body>
    <nav><a href="/">Go Home</a></nav>
    <main>
      <h1>Hello, <%= user.username.split("@")[0] %></h1>
      <p>
        Your file <strong><%= file.name %></strong> is of size
        <strong><%= file.size %> bytes</strong>
      </p>
    </main>
    <footer>
      <a href="https://github.com/nzubeifechukwu/file-uploader" target="_blank"
        ><small>&copy; Nzube Ifechukwu</small></a
      >
    </footer>
  </body>
</html>
